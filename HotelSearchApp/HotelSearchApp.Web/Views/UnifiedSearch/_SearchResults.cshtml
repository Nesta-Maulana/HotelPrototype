@model HotelSearchApp.Web.Models.UnifiedSearchViewModel

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="search-error alert alert-danger">
        @Model.ErrorMessage
    </div>
}
else if (Model.SearchResults != null)
{
    <div class="search-info">
        <strong>Search Method:</strong> @Model.SearchMethod |
        <strong>Execution Time:</strong> @Model.TotalElapsedMilliseconds ms | 
        <strong>Total Results:</strong> @Model.SearchResults.TotalHits hotels
    </div>

    <div class="search-results-list">
        @if (Model.SearchResults.IsCountrySearch && Model.SearchResults.TopCities.Any())
        {
            <div class="country-search-container">
                <div class="country-header">Top Cities in @Model.SearchQuery</div>
                <div class="top-cities-container">
                    <div class="cities-list">
                        @foreach (var city in Model.SearchResults.TopCities)
                        {
                            <div class="city-item" onclick="searchCity('@city')">
                                <span class="city-icon">📍</span>
                                <span class="city-name">@city</span>
                            </div>
                        }
                    </div>
                </div>
                
                <div class="search-section-divider">
                    <span class="section-label">Top Hotels</span>
                </div>
                
                <div class="top-hotels-section">
                    @foreach (var hotel in Model.SearchResults.Items)
                    {
                        <div class="country-result-item">
                            <div class="hotel-info">
                                <div class="hotel-name">
                                    @if (!string.IsNullOrEmpty(hotel.HotelCode))
                                    {
                                        <span class="code-highlight">@hotel.HotelCode</span>
                                    }
                                    @hotel.HotelName
                                </div>
                                <div class="hotel-location">
                                    <span class="location-icon">📍</span>
                                    @hotel.Address1
                                    @if (!string.IsNullOrEmpty(hotel.Address2))
                                    {
                                        <span>, @hotel.Address2</span>
                                    }
                                    <span>, @hotel.CityName, @hotel.Country</span>
                                </div>
                                @if (!string.IsNullOrEmpty(hotel.PhoneNumber))
                                {
                                    <div class="hotel-contact">
                                        <small>Contact: @hotel.PhoneNumber</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (Model.SearchResults.IsHotelCodeSearch)
        {
            <div class="hotel-code-search-results">
                <div class="search-code-info">
                    <p>Showing results for hotel code search: <strong>@Model.SearchQuery</strong></p>
                </div>
                <div class="top-hotels-section">
                    @foreach (var hotel in Model.SearchResults.Items)
                    {
                        <div class="country-result-item">
                            <div class="hotel-info">
                                <div class="hotel-name">
                                    @if (!string.IsNullOrEmpty(hotel.HotelCode))
                                    {
                                        <span class="code-highlight">@hotel.HotelCode</span>
                                    }
                                    @hotel.HotelName
                                </div>
                                <div class="hotel-location">
                                    <span class="location-icon">📍</span>
                                    @hotel.Address1
                                    @if (!string.IsNullOrEmpty(hotel.Address2))
                                    {
                                        <span>, @hotel.Address2</span>
                                    }
                                    <span>, @hotel.CityName, @hotel.Country</span>
                                </div>
                                @if (!string.IsNullOrEmpty(hotel.PhoneNumber))
                                {
                                    <div class="hotel-contact">
                                        <small>Contact: @hotel.PhoneNumber</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else if (Model.SearchResults.TotalHits > 0)
        {
            <div class="country-search-container">
                <div class="country-header">Hotels in @Model.SearchQuery</div>
                
                @* Show top areas/districts if available *@
                @{
                    var uniqueAreas = Model.SearchResults.Items
                        .Where(h => !string.IsNullOrEmpty(h.Address1) && h.Address1 != "N/A")
                        .GroupBy(h => h.Address1)
                        .OrderByDescending(g => g.Count())
                        .Take(5)
                        .Select(g => g.Key)
                        .ToList();
                }
                
                @if (uniqueAreas.Any())
                {
                    <div class="top-cities-container">
                        <strong>Popular Areas:</strong>
                        <div class="cities-list">
                            @foreach (var area in uniqueAreas)
                            {
                                <div class="city-item" onclick="searchArea('@area')">
                                    <span class="city-icon">🏢</span>
                                    <span class="city-name">@area</span>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <div class="search-section-divider">
                        <span class="section-label">All Hotels</span>
                    </div>
                }
                
                <div class="top-hotels-section">
                    @foreach (var hotel in Model.SearchResults.Items)
                    {
                        <div class="country-result-item">
                            <div class="hotel-info">
                                <div class="hotel-name">
                                    @if (!string.IsNullOrEmpty(hotel.HotelCode))
                                    {
                                        <span class="code-highlight">@hotel.HotelCode</span>
                                    }
                                    @hotel.HotelName
                                </div>
                                <div class="hotel-location">
                                    <span class="location-icon">📍</span>
                                    @hotel.Address1
                                    @if (!string.IsNullOrEmpty(hotel.Address2))
                                    {
                                        <span>, @hotel.Address2</span>
                                    }
                                    <span>, @hotel.CityName, @hotel.Country</span>
                                </div>
                                @if (!string.IsNullOrEmpty(hotel.PhoneNumber))
                                {
                                    <div class="hotel-contact">
                                        <small>Contact: @hotel.PhoneNumber</small>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="result-item no-results">
                <div class="result-primary">No hotels found for "<strong>@Model.SearchQuery</strong>"</div>
                <div class="suggestions">
                    <p>Try:</p>
                    <ul>
                        <li>Checking your spelling</li>
                        <li>Using more general keywords</li>
                        <li>Searching by hotel name, city, or hotel code</li>
                        <li>Enter a hotel code number (e.g., 10000121) to find specific hotels</li>
                        <li>Use at least 3 characters for better results</li>
                    </ul>
                </div>
            </div>
        }
    </div>

    @if (Model.SearchResults.TotalPages > 1)
    {
        <div class="pagination">
            @if (Model.SearchResults.HasPreviousPage)
            {
                <a href="javascript:void(0)" onclick="loadPage(@(Model.SearchResults.PageNumber - 1))">Previous</a>
            }

            @for (int i = Math.Max(1, Model.SearchResults.PageNumber - 2); i <= Math.Min(Model.SearchResults.TotalPages, Model.SearchResults.PageNumber + 2); i++)
            {
                <a href="javascript:void(0)" 
                   onclick="loadPage(@i)" 
                   class="@(i == Model.SearchResults.PageNumber ? "active" : "")">@i</a>
            }

            @if (Model.SearchResults.HasNextPage)
            {
                <a href="javascript:void(0)" onclick="loadPage(@(Model.SearchResults.PageNumber + 1))">Next</a>
            }
        </div>
    }
}
else
{
    <div class="result-item">
        <div class="result-primary">Start typing to search...</div>
        <div class="search-tips">
            <p><small>Search tips:</small></p>
            <ul>
                <li><small>Search by hotel name, city, or hotel code</small></li>
                <li><small>Search works even with misspelled words</small></li>
                <li><small>Search by country name to see top cities and hotels</small></li>
                <li><small>Enter a hotel code number (e.g., 10000121) to find specific hotels</small></li>
                <li><small>Use at least 3 characters for better results</small></li>
            </ul>
        </div>
    </div>
}

<script>
    function searchCity(cityName) {
        document.getElementById('SearchQuery').value = cityName;
        performSearch(cityName);
    }
    
    function searchArea(areaName) {
        document.getElementById('SearchQuery').value = areaName;
        performSearch(areaName);
    }
</script>

<style>
    .search-info {
        margin-bottom: 20px;
        padding: 10px;
        background-color: #f0f0f0;
        border-radius: 4px;
        font-size: 14px;
    }
    
    /* Country/City Search Container Styles */
    .country-search-container {
        margin-bottom: 25px;
    }

    .country-header {
        font-size: 22px;
        font-weight: 600;
        margin-bottom: 15px;
        color: #333;
        border-bottom: 2px solid #007bff;
        padding-bottom: 10px;
    }

    .top-cities-container {
        background-color: #f8f9fa;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 20px;
        border: 1px solid #e9ecef;
    }

    .cities-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 10px;
    }

    .city-item {
        background-color: white;
        border: 1px solid #e0e0e0;
        border-radius: 20px;
        padding: 8px 16px;
        transition: all 0.2s ease;
        cursor: pointer;
        display: flex;
        align-items: center;
    }

    .city-item:hover {
        background-color: #007bff;
        color: white;
        border-color: #007bff;
        transform: translateY(-2px);
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .city-icon {
        margin-right: 6px;
        font-size: 14px;
    }

    .city-name {
        font-weight: 500;
    }

    .top-hotels-section {
        margin-top: 25px;
    }

    .country-result-item {
        display: flex;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 12px;
        background-color: white;
        border: 1px solid #eee;
        transition: all 0.2s ease;
    }

    .country-result-item:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.08);
        border-color: #d0d0d0;
    }

    .hotel-info {
        flex: 1;
    }

    .hotel-name {
        font-weight: 600;
        font-size: 16px;
        color: #333;
        margin-bottom: 5px;
    }

    .hotel-location {
        font-size: 14px;
        color: #666;
        display: flex;
        align-items: center;
        margin-bottom: 3px;
    }

    .hotel-contact {
        font-size: 12px;
        color: #999;
    }

    .location-icon {
        margin-right: 5px;
        color: #007bff;
    }

    .search-section-divider {
        margin: 30px 0;
        border-top: 1px solid #eee;
        position: relative;
    }

    .section-label {
        position: absolute;
        top: -10px;
        left: 50%;
        transform: translateX(-50%);
        background: white;
        padding: 0 15px;
        color: #666;
        font-size: 14px;
        font-weight: 500;
    }

    /* Hotel Code Search Styles */
    .hotel-code-search-results {
        margin-bottom: 20px;
    }

    .search-code-info {
        background-color: #edf8ff;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 15px;
        border-left: 4px solid #007bff;
    }

    .search-code-info p {
        margin: 0;
        color: #0056b3;
    }

    .hotel-code-result {
        padding: 15px;
        border-radius: 8px;
        background-color: #f8f9fa;
        border: 1px solid #e9ecef;
        margin-bottom: 12px;
        transition: transform 0.2s ease;
    }

    .hotel-code-result:hover {
        transform: translateY(-2px);
        box-shadow: 0 3px 8px rgba(0,0,0,0.05);
    }

    .code-highlight {
        color: #d63384;
        font-weight: 600;
        background-color: #f8f0f4;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 12px;
        margin-right: 8px;
        font-family: monospace;
    }

    /* Regular result styles for fallback */
    .result-item {
        padding: 15px;
        border-bottom: 1px solid #eee;
        cursor: pointer;
    }
    
    .result-item:hover {
        background-color: #f9f9f9;
    }
    
    .result-primary {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 16px;
        margin-bottom: 5px;
    }
    
    .result-address {
        font-size: 14px;
        color: #666;
    }
    
    .result-phone {
        margin-top: 5px;
    }
    
    .highlight {
        color: #007bff;
        font-weight: 500;
    }
    
    .no-results {
        text-align: center;
        padding: 40px 20px;
    }
    
    .suggestions ul {
        text-align: left;
        margin-top: 15px;
    }
    
    .pagination {
        margin-top: 20px;
        display: flex;
        gap: 10px;
    }
    
    .pagination a {
        padding: 8px 16px;
        text-decoration: none;
        color: black;
        border: 1px solid #ddd;
        border-radius: 4px;
    }
    
    .pagination a.active {
        background-color: #4CAF50;
        color: white;
    }
    
    .pagination a:hover:not(.active) {
        background-color: #ddd;
    }

    /* Search Error Styles */
    .search-error {
        background-color: #f8d7da;
        color: #721c24;
        padding: 12px;
        border-radius: 4px;
        border: 1px solid #f5c6cb;
        margin-bottom: 20px;
    }

    /* Search Tips Styles */
    .search-tips {
        margin-top: 10px;
    }

    .search-tips ul {
        margin-top: 10px;
        padding-left: 20px;
    }

    .search-tips li {
        margin-bottom: 5px;
    }
</style>